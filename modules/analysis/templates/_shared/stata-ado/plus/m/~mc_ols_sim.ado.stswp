* version 1.0

cap program drop mc_ols_sim
program define mc_ols_sim, rclass // 定义蒙特卡洛模拟程序，rclass表示可返回标量
    syntax , n(numlist) [dist(string) reps(integer 1000) beta0(real 1) beta1(real 2)] // 定义语法，n为样本量列表，dist为分布类型，reps为模拟次数默认1000，beta0和beta1为回归系数默认值1和2
    
    local n_list `n' // 保存样本量列表
    
    // 对每个样本量进行模拟
    foreach nn of local n_list {
        tempname results // 创建临时文件名
        postfile `results' rep b0 b1 using results_temp_`nn'.dta, replace // 创建结果存储文件
        
        di as text "样本量 n = `nn'，分布为 `dist'，模拟 `reps' 次...（数据生成过程为Y=1+2*X+U）" // 显示当前进度
        
        forvalues r = 1/`reps' { // 进行指定次数模拟
            // 嵌入的ols_sim程序
            clear // 清除当前数据
            qui set obs `nn' // 设置样本量为nn
            
            // 处理分布选项，默认为均匀分布
            if "`dist'" == "" local dist "uniform"
            
            if "`dist'" == "uniform" {
                gen x = runiform(0,1) // 生成均匀分布自变量X~U(0,1)
                gen u = runiform(-0.5,0.5) // 生成均匀分布误差项U~U(-0.5,0.5)
            }
            else if "`dist'" == "normal" {
                gen x = rnormal(0,1) // 生成正态分布自变量X~N(0,1)
                gen u = rnormal(0,1) // 生成正态分布误差项U~N(0,1)
            }
            else if "`dist'" == "binomial" {
                gen x = rbinomial(10, 0.3)/10 // 标准化二项分布自变量
                gen u = rbinomial(10, 0.5)/10 - 0.5 // 标准化二项分布误差项
            }
            else if "`dist'" == "poisson" {
                gen x = rpoisson(2)/2 // 标准化泊松分布自变量
                gen u = rpoisson(2)/2 - 1 // 标准化泊松分布误差项
            }
            else if "`dist'" == "exponential" {
                gen x = rexponential(1)/2 // 标准化指数分布自变量
                gen u = rexponential(1)/2 - 0.5 // 标准化指数分布误差项
            }
            else if "`dist'" == "chi2" {
                gen x = rchi2(3)/3 // 标准化卡方分布自变量
                gen u = rchi2(3)/3 - 1 // 标准化卡方分布误差项
            }
            else if "`dist'" == "cauchy" {
                gen x = rt(1)/10 // 标准化柯西分布自变量（除以10避免过大值）
                gen u = rt(1)/10 // 标准化柯西分布误差项
            }
            
            gen y = `beta0' + `beta1'*x + u // 生成因变量Y=beta0+beta1*X+U
            qui regress y x // 进行OLS回归
            scalar b0_hat = _b[_cons] // 保存截距估计值
            scalar b1_hat = _b[x] // 保存斜率估计值
            
            post `results' (`r') (b0_hat) (b1_hat) // 将结果存入文件

            if mod(`r',100)==0 { // 每100次显示一次进度
                di as result "    已完成 `r' / `reps'"
            }
        }
        postclose `results' // 关闭结果存储文件
        di as text "样本量 n = `nn' 的模拟完成！" // 显示该样本量模拟完成
        
        // 计算统计量并返回
        use results_temp_`nn'.dta, clear
        gen n_var = `nn' // 添加样本量变量
        summarize b0 b1
        return scalar b0_mean = r(mean)
        return scalar b1_mean = r(mean)
        return scalar b0_sd = r(sd)
        return scalar b1_sd = r(sd)
        save results_n`nn'_`dist'.dta, replace // 保存结果文件
    }
    
    // 合并所有样本量的结果到一个文件
    clear
    gen rep = .
    gen b0 = .
    gen b1 = .
    gen n = .
    save results.dta, replace

    foreach nn of local n_list {
        capture use results_n`nn'_`dist'.dta, clear
        if _rc == 0 {
            gen n = `nn'
            append using aresults.dta
            save results.dta, replace
        }
    }
    di as text "所有样本量数据已合并完成！"
end