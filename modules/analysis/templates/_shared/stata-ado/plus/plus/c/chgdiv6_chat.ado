	local sym001100 "小过"
	local sym010101 "既济"
	local sym101010 "未济"
	
	 //展示卦象
	di in white "这是六爻占卜得到的卦象："
	mat l divinatory
	di in white "为`sym`div''之`sym`chgdiv''卦。"
	
	//输入完毕，开始占卜'
	if `chgsum'==0{
		local result "`div`div'_0'"
		local resweb "`sym`div''卦的卦辞"
	}
	else if `chgsum'==1{
		foreach row in 1 2 3 4 5 6{
			if el(divinatory,`row',1) != el(divinatory,`row',2){
				local result "`div`div'_`row''"
				if el(divinatory,`row',1)==1{
					local restool "九"
				}
				if el(divinatory,`row',1)==0{
					local restool "六"
				}
				if `row'==1{
					local resweb "`sym`div''卦上`restool'爻辞"
				}
				if `row'==2{
					local resweb "`sym`div''卦`restool'五爻辞"
				}
				if `row'==3{
					local resweb "`sym`div''卦`restool'四爻辞"
				}
				if `row'==4{
					local resweb "`sym`div''卦`restool'三爻辞"
				}
				if `row'==5{
					local resweb "`sym`div''卦`restool'二爻辞"
				}
				if `row'==6{
					local resweb "`sym`div''卦初`restool'爻辞"
				}
			}
		}
	}
	else if `chgsum'==2{
		foreach row in 6 5 4 3 2 1{
			if el(divinatory,`row',1) != el(divinatory,`row',2){
				local aresult "`div`div'_`row''"
				local result "`aresult'" _n "`result'"
				if el(divinatory,`row',1)==1{
					local restool "九"
				}
				if el(divinatory,`row',1)==0{
					local restool "六"
				}
				if `row'==1{
					local aresweb "`sym`div''卦上`restool'爻辞"
				}
				if `row'==2{
					local aresweb "`sym`div''卦`restool'五爻辞"
				}
				if `row'==3{
					local aresweb "`sym`div''卦`restool'四爻辞"
				}
				if `row'==4{
					local aresweb "`sym`div''卦`restool'三爻辞"
				}
				if `row'==5{
					local aresweb "`sym`div''卦`restool'二爻辞"
				}
				if `row'==6{
					local aresweb "`sym`div''卦初`restool'爻辞"
				}
				local resweb "`aresweb';`resweb'"
			}
		}
	}
	else if `chgsum'==3{
		if el(divinatory,6,1) == el(divinatory,6,2){
			local result "`div`div'_0'" _n "`div`chgdiv'_0'" _n "请进一步看对应彖辞"
			local resweb "`sym`div''卦卦辞和`sym`chgdiv''卦卦辞"
		}
		else if el(divinatory,6,1) != el(divinatory,6,2){
		    local result "`div`chgdiv'_0'" _n "`div`div'_0'" _n "请进一步看对应彖辞"
			local resweb "`sym`chgdiv''卦卦辞和`sym`div''卦卦辞"
		}
	}
	else if `chgsum'==4{
		foreach row in 1 2 3 4 5 6{
			if el(divinatory,`row',1) == el(divinatory,`row',2){
				local aresult "`div`chgdiv'_`row''"
				local result "`aresult'" _n "`result'" 
				local resweb "`aresult'和`resweb'"
				if el(divinatory,`row',1)==1{
					local restool "九"
				}
				if el(divinatory,`row',1)==0{
					local restool "六"
				}
				if `row'==1{
					local aresweb "`sym`chgdiv''卦上`restool'爻辞"
				}
				if `row'==2{
					local aresweb "`sym`chgdiv''卦`restool'五爻辞"
				}
				if `row'==3{
					local aresweb "`sym`chgdiv''卦`restool'四爻辞"
				}
				if `row'==4{
					local aresweb "`sym`chgdiv''卦`restool'三爻辞"
				}
				if `row'==5{
					local aresweb "`sym`chgdiv''卦`restool'二爻辞"
				}
				if `row'==6{
					local aresweb "`sym`chgdiv''卦初`restool'爻辞"
				}
				local resweb "`aresweb';`resweb'"
			}
		}
	}
	else if `chgsum'==5{
		foreach row in 1 2 3 4 5 6{
			if el(divinatory,`row',1) == el(divinatory,`row',2){
				local result "`div`chgdiv'_`row''"
				local resweb "`div`chgdiv'_`row''"
				if el(divinatory,`row',1)==1{
					local restool "九"
				}
				if el(divinatory,`row',1)==0{
					local restool "六"
				}
				if `row'==1{
					local resweb "`sym`chgdiv''卦上`restool'爻辞"
				}
				if `row'==2{
					local resweb "`sym`chgdiv''卦`restool'五爻辞"
				}
				if `row'==3{
					local resweb "`sym`chgdiv''卦`restool'四爻辞"
				}
				if `row'==4{
					local resweb "`sym`chgdiv''卦`restool'三爻辞"
				}
				if `row'==5{
					local resweb "`sym`chgdiv''卦`restool'二爻辞"
				}
				if `row'==6{
					local resweb "`sym`chgdiv''卦初`restool'爻辞"
				}
			}
		}
	}
	else if `chgsum'==6{
		local result "`div`chgdiv'_0'"
		if "`div'"=="111111"{
		local result "用九：见群龙无首，吉。《象》曰：用九，天德不可为首也。"
		local resweb "乾卦用九爻辞"
		}
		else if "`div'"=="000000"{
		local result "用六：利，永贞。《象》曰：用六永贞，以大终也。"
		local resweb "困卦用六爻辞"
		}
	}
	di in white _n "这是《易》中的卦/爻辞与注释，两条辞则以前者为主：" _n "`result'"
	if `quif' ==1{
	    di `"{browse "https://metaso.cn/?q=我想问`question',占卜得到的结果是`resweb'请你分析": AI搜索网页 }"'
	}
	else {
		di `"{browse "https://metaso.cn/?q=我占卜的结果是`resweb'请你分析": AI搜索网页 }"'
	}
	ma drop _all
end